#!/usr/bin/env bash
set -euo pipefail

[[ "$(git symbolic-ref --short HEAD 2>/dev/null || true)" == "main" ]] || exit 0

subject="$(grep -v '^#' "$1" | sed -n '/./{p;q;}')"
[[ "${subject}" =~ ^Merge\  || "${subject}" =~ ^Revert\  ]] && exit 0

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9/_-]+\))?(!)?: .+'
[[ "${subject}" =~ ${pattern} ]] || exit 1
